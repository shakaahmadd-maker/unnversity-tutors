                return;
            }
            const room = chatRooms.find(r => r.id === activeRoomId);
            if (room) updateComposerUI(room);
        }

        function updateComposerUI(room) {
            const csrBtn = document.getElementById("roleBtn-csr");
            const tutorBtn = document.getElementById("roleBtn-tutor");
            const badge = document.getElementById("activePostingBadge");
            const input = document.getElementById("adminMessageInput");
            const submitBtn = document.getElementById("sendMsgSubmitBtn");
            const sendLabel = document.getElementById("sendBtnLabel");
            const composerWrapper = document.getElementById("composerWrapper");
            const quickRepliesBar = document.getElementById("quickRepliesBar");

            if (senderIdentity === "csr") {
                csrBtn.className = "flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-brand-600 text-white shadow-2xs transition";
                tutorBtn.className = "flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 transition";
                badge.className = "text-[11px] text-brand-700 bg-brand-50 border border-brand-200 px-2.5 py-0.5 rounded-full font-medium";
                badge.textContent = "Replying in CSR Support Desk Chat";
                input.placeholder = "Write support reply as CSR Desk...";
                input.className = "flex-1 px-4 py-2.5 bg-slate-50 focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition";
                submitBtn.className = "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-brand-600 hover:bg-brand-700 text-white shadow-xs transition active:scale-95 shrink-0 cursor-pointer";
                sendLabel.textContent = "Send as CSR";
                composerWrapper.className = "p-3.5 sm:p-4 bg-white border-t-2 border-brand-500/50 shrink-0 transition-colors duration-300";

                const csrTemplates = [
                    "Your billing escrow is verified and active.",
                    "Please keep all payments & files inside the platform workspace.",
                    "I have extended your submission review window by 24 hours.",
                    "How else can Operational Support assist you today?"
                ];
                quickRepliesBar.innerHTML = `<span class="text-[10px] font-semibold text-slate-400 shrink-0">Quick CSR:</span>` + csrTemplates.map(t => `
                    <button type="button" onclick="insertQuickReply('${t.replace(/'/g, "\\'")}')" class="px-2.5 py-1 rounded-lg bg-brand-50/80 hover:bg-brand-100 text-brand-800 border border-brand-200/70 text-[11px] font-medium whitespace-nowrap transition cursor-pointer">
                        ${t}
                    </button>
                `).join("");
            } else {
                tutorBtn.className = "flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-600 text-white shadow-2xs transition";
                csrBtn.className = "flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 transition";
                badge.className = "text-[11px] text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full font-medium";
                badge.textContent = `Replying as ${room.tutor.name} in Tutor Chat`;
                input.placeholder = `Reply to ${room.student.name} as ${room.tutor.name}...`;
                input.className = "flex-1 px-4 py-2.5 bg-slate-50 focus:bg-white border border-slate-200 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition";
                submitBtn.className = "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs transition active:scale-95 shrink-0 cursor-pointer";
                sendLabel.textContent = "Send as Tutor";
                composerWrapper.className = "p-3.5 sm:p-4 bg-white border-t-2 border-emerald-500/50 shrink-0 transition-colors duration-300";

                const tutorTemplates = [
                    "I have reviewed your uploaded files in the vault.",
                    "Let's walk through the methodology step by step.",
                    "Could you upload your latest draft brief so I can check it?",
                    "Everything looks aligned with your syllabus deadline!"
                ];
                quickRepliesBar.innerHTML = `<span class="text-[10px] font-semibold text-slate-400 shrink-0">Quick Tutor:</span>` + tutorTemplates.map(t => `
                    <button type="button" onclick="insertQuickReply('${t.replace(/'/g, "\\'")}')" class="px-2.5 py-1 rounded-lg bg-emerald-50/80 hover:bg-emerald-100 text-emerald-800 border border-emerald-200/70 text-[11px] font-medium whitespace-nowrap transition cursor-pointer">
                        ${t}
                    </button>
                `).join("");
            }
        }

        function insertQuickReply(text) {
            const input = document.getElementById("adminMessageInput");
            input.value = text;
            input.focus();
        }

        function copyRoomId() {
            const tempInput = document.createElement("input");
            tempInput.value = activeRoomId;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);
            triggerActionToast(`Copied Room ID ${activeRoomId} to clipboard`);
        }

        function updateChannelBadges(room) {
            document.getElementById("tutorMsgBadge").textContent = room.tutorMessages.length;
            document.getElementById("csrMsgBadge").textContent = room.csrMessages.length;
        }

        function renderMessages(room) {
            const container = document.getElementById("chatMessagesContainer");
            container.innerHTML = "";

            const messagesList = activeChatChannel === "csr" ? room.csrMessages : room.tutorMessages;

            if (messagesList.length === 0) {
                container.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-center py-12 px-4">
                        <div class="w-12 h-12 rounded-2xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 mb-3">
                            <i data-lucide="${activeChatChannel === 'csr' ? 'headphones' : 'message-square'}" class="w-6 h-6"></i>
                        </div>
                        <p class="text-sm font-semibold text-slate-700">No messages in this ${activeChatChannel === 'csr' ? 'CSR Support' : 'Tutor Consultation'} thread yet</p>
                        <p class="text-xs text-slate-400 mt-1 max-w-sm">Use the composer below to start the conversation as ${activeChatChannel === 'csr' ? 'CSR Support Desk' : room.tutor.name}.</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            messagesList.forEach(msg => {
                const wrapper = document.createElement("div");

                if (msg.senderRole === "csr") {
                    // CSR Support Message (Right Aligned with Brand Orange Styling)
                    wrapper.className = "flex flex-col items-end ml-auto max-w-2xl";
                    wrapper.innerHTML = `
                        <div class="flex items-center gap-2 mb-1 px-1">
                            <span class="text-[11px] text-slate-400">${msg.time} •</span>
                            <span class="text-xs font-semibold text-slate-700">${msg.senderName}</span>
                            <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-brand-100 text-brand-700 uppercase">CSR Desk</span>
                        </div>
                        <div class="px-4 py-3 rounded-2xl rounded-tr-sm bg-brand-600 text-white text-sm leading-relaxed shadow-xs">
                            ${msg.text}
                        </div>
                    `;
                } else if (msg.senderRole === "student") {
                    // Student Bubble (Left Aligned)
                    wrapper.className = "flex flex-col items-start max-w-2xl";
                    wrapper.innerHTML = `
                        <div class="flex items-center gap-2 mb-1 px-1">
                            <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-blue-100 text-blue-700 uppercase">Student</span>
                            <span class="text-xs font-semibold text-slate-700">${msg.senderName}</span>
                            <span class="text-[11px] text-slate-400">• ${msg.time}</span>
                        </div>
                        <div class="px-4 py-3 rounded-2xl rounded-tl-sm bg-white border border-blue-200/80 text-slate-800 text-sm leading-relaxed shadow-2xs">
                            ${msg.text}
                        </div>
                    `;
                } else {
                    // Tutor Bubble (Right Aligned for clear visual distinction)
                    wrapper.className = "flex flex-col items-end ml-auto max-w-2xl";
                    wrapper.innerHTML = `
                        <div class="flex items-center gap-2 mb-1 px-1">
                            <span class="text-[11px] text-slate-400">${msg.time} •</span>
                            <span class="text-xs font-semibold text-slate-700">${msg.senderName}</span>
                            <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700 uppercase">Tutor</span>
                        </div>
                        <div class="px-4 py-3 rounded-2xl rounded-tr-sm bg-slate-900 text-white text-sm leading-relaxed shadow-xs">
                            ${msg.text}
                        </div>
                    `;
                }

                container.appendChild(wrapper);
            });

            container.scrollTop = container.scrollHeight;
            lucide.createIcons();
        }

        // ==========================================
        // INTERACTIVE CONTROLS
        // ==========================================
        function setDirectoryTab(tab) {
            currentTab = tab;
            document.querySelectorAll(".dir-tab").forEach(btn => {
                btn.classList.remove("bg-white", "text-slate-900", "shadow-xs", "font-semibold");
                btn.classList.add("text-slate-600");
            });
            const activeBtn = document.getElementById(`tab-${tab}`);
            activeBtn.classList.add("bg-white", "text-slate-900", "shadow-xs", "font-semibold");
            activeBtn.classList.remove("text-slate-600");
            renderDirectory();
        }

        function filterDirectory() {
            renderDirectory();
        }

        function sendAdminMessage(event) {
            event.preventDefault();
            const input = document.getElementById("adminMessageInput");
            const text = input.value.trim();
            if (!text) return;

            const room = chatRooms.find(r => r.id === activeRoomId);
            if (!room) return;

            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            if (senderIdentity === "csr") {
                room.csrMessages.push({
                    senderRole: "csr",
                    senderName: "CSR Support Desk",
                    time: timeStr,
                    text: text
                });
                room.lastMessage = `[CSR]: ${text}`;
            } else {
                room.tutorMessages.push({
                    senderRole: "tutor",
                    senderName: room.tutor.name,
                    time: timeStr,
                    text: text
                });
                room.lastMessage = `[${room.tutor.name}]: ${text}`;
            }
            room.lastTime = timeStr;

            input.value = "";
            updateChannelBadges(room);
            renderMessages(room);
            renderDirectory();
        }

        // EXPAND FULL PAGE TOGGLE
        function toggleFullScreen() {
            isExpanded = !isExpanded;
            const wrapper = document.getElementById("appWrapper");
            const card = document.getElementById("deskCard");
            const expandText = document.getElementById("expandText");
            const expandIcon = document.getElementById("expandIcon");

            if (isExpanded) {
                wrapper.classList.remove("max-w-[1600px]", "p-3", "sm:p-6");
                wrapper.classList.add("max-w-full", "p-0", "h-screen");
                card.classList.remove("rounded-2xl", "min-h-[820px]");
                card.classList.add("rounded-none", "h-full");
                expandText.textContent = "Exit Full Page";
                expandIcon.setAttribute("data-lucide", "minimize-2");
                triggerActionToast("Expanded Control Desk to Full Screen");
            } else {
                wrapper.classList.add("max-w-[1600px]", "p-3", "sm:p-6");
                wrapper.classList.remove("max-w-full", "p-0", "h-screen");
                card.classList.add("rounded-2xl", "min-h-[820px]");
                card.classList.remove("rounded-none", "h-full");
                expandText.textContent = "Expand Full Page";
                expandIcon.setAttribute("data-lucide", "maximize-2");
            }
            lucide.createIcons();
        }

        // TOGGLE RIGHT INSPECTOR DRAWER
        function toggleInspector() {
            isInspectorVisible = !isInspectorVisible;
            const drawer = document.getElementById("inspectorDrawer");
            const btnText = document.getElementById("inspectorBtnText");

            if (isInspectorVisible) {
                drawer.classList.remove("hidden");
                drawer.classList.add("flex");
                btnText.textContent = "Hide Records";
            } else {
                drawer.classList.add("hidden");
                drawer.classList.remove("flex");
                btnText.textContent = "Show Records";
            }
        }

        // TOAST & MODAL HELPERS
        let toastTimeout;
        function triggerActionToast(message) {
            const toast = document.getElementById("toastNotification");
            document.getElementById("toastMessage").textContent = message;
            toast.classList.remove("translate-y-20", "opacity-0");
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add("translate-y-20", "opacity-0");
            }, 3000);
        }

        function openPurgeModal() {
            const modal = document.getElementById("purgeModal");
            modal.classList.remove("hidden");
            modal.classList.add("flex");
        }

        function closePurgeModal() {
            const modal = document.getElementById("purgeModal");
            modal.classList.add("hidden");
            modal.classList.remove("flex");
        }

        function confirmPurge() {
            closePurgeModal();
            triggerActionToast(`Thread ${activeRoomId} archived & purged.`);
        }

        // Initialize UI on Load
        window.onload = function() {
            selectRoom("#1794746583002");
            lucide.createIcons();
        };
    </script>
</body>
</html>