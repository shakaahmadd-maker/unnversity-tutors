<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Universal 6-System University Grade & Credit Converter — University-Tutors.com</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    body { font-family: 'Inter', sans-serif; background-color: #F9FAFB; color: #111827; }
    .archetype-card { transition: all 0.18s ease; }
    @media print {
      body { background: #FFFFFF !important; }
      body > *:not(#officialPrintReport) { display: none !important; }
      #officialPrintReport {
        display: block !important;
        position: static !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      @page { size: A4; margin: 14mm; }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Top Brand Header -->
  <header class="bg-white border-b border-gray-200 px-4 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-3 sticky top-0 z-20">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-orange-500 text-white font-extrabold flex items-center justify-center text-lg shadow-sm">U</div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-gray-900 text-base">University-Tutors<span class="text-orange-500">.com</span></span>
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-orange-50 text-orange-600 border border-orange-200">Universal Grade & Credit Converter</span>
        </div>
        <p class="text-xs text-gray-500">All 6 World Grading Systems → English-Speaking Study Destinations & ECTS</p>
      </div>
    </div>
    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-full">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span> 100% Free & Official Formulas
    </span>
  </header>

  <!-- Main Workspace -->
  <main class="flex-1 max-w-6xl w-full mx-auto p-4 lg:p-8 space-y-6">

    <!-- Hero Title -->
    <div class="text-center max-w-3xl mx-auto">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
        Universal <span class="text-orange-500">6-System University Grade</span> & Credit Converter
      </h1>
      <p class="text-sm text-gray-600 mt-2">
        Select your home university’s <strong>Grading System Type</strong> (or country preset), adjust for <strong>Absolute vs. Relative (Bell-Curve)</strong> grading, and convert into <strong>UK, USA, Canada, Australia, Ireland, New Zealand, or Singapore</strong>.
      </p>
    </div>

    <!-- Step 1: Visual 6 Grading System Archetypes Selector -->
    <section class="bg-white rounded-2xl border border-gray-200 p-5 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3.5">
        <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500">Step 1: Choose Your Home University’s Grading System Type</h2>
        <span class="text-[11px] font-medium text-gray-500">Covers 99% of global universities</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" id="archetypeGrid">
        <button type="button" onclick="selectArchetype('gpa')" id="arch-gpa" class="archetype-card text-left p-3.5 rounded-xl border-2 border-orange-500 bg-orange-50/50 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold text-orange-600">1. GPA / Letter Scale</span>
            <span class="text-[10px] font-bold bg-white border border-orange-200 text-gray-700 px-2 py-0.5 rounded">4.0 / 4.33 / 5.0</span>
          </div>
          <p class="text-[11px] text-gray-600 mt-1">USA, Canada, Pakistan (HEC), South Korea, Saudi Arabia, Nigeria</p>
        </button>

        <button type="button" onclick="selectArchetype('percentage')" id="arch-percentage" class="archetype-card text-left p-3.5 rounded-xl border border-gray-200 bg-white hover:border-orange-300">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold text-gray-900">2. Percentage & Division</span>
            <span class="text-[10px] font-bold bg-gray-100 text-gray-700 px-2 py-0.5 rounded">0–100%</span>
          </div>
          <p class="text-[11px] text-gray-500 mt-1">India (Annual/State), Pakistan (Annual), China (60% pass), South Africa</p>
        </button>

        <button type="button" onclick="selectArchetype('honours')" id="arch-honours" class="archetype-card text-left p-3.5 rounded-xl border border-gray-200 bg-white hover:border-orange-300">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold text-gray-900">3. Honours Degree Class</span>
            <span class="text-[10px] font-bold bg-gray-100 text-gray-700 px-2 py-0.5 rounded">1st / 2:1 / 2:2</span>
          </div>
          <p class="text-[11px] text-gray-500 mt-1">United Kingdom, Ireland, Kenya, Ghana (40% pass mark)</p>
        </button>

        <button type="button" onclick="selectArchetype('descriptive')" id="arch-descriptive" class="archetype-card text-left p-3.5 rounded-xl border border-gray-200 bg-white hover:border-orange-300">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold text-gray-900">4. Descriptive Band Scale</span>
            <span class="text-[10px] font-bold bg-gray-100 text-gray-700 px-2 py-0.5 rounded">HD / D / Cr / P</span>
          </div>
          <p class="text-[11px] text-gray-500 mt-1">Australia (7.0 / HD–P), New Zealand (9.0 / A+ to C-, 50% pass)</p>
        </button>

        <button type="button" onclick="selectArchetype('numerical')" id="arch-numerical" class="archetype-card text-left p-3.5 rounded-xl border border-gray-200 bg-white hover:border-orange-300">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold text-gray-900">5. Numerical Point Scale</span>
            <span class="text-[10px] font-bold bg-gray-100 text-gray-700 px-2 py-0.5 rounded">0–10 / 0–20 / 0–30</span>
          </div>
          <p class="text-[11px] text-gray-500 mt-1">India (10-pt CGPA), France (0–20), Netherlands (0–10), Italy (18–30)</p>
        </button>

        <button type="button" onclick="selectArchetype('inverted')" id="arch-inverted" class="archetype-card text-left p-3.5 rounded-xl border border-gray-200 bg-white hover:border-orange-300">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold text-gray-900">6. Inverted Numerical</span>
            <span class="text-[10px] font-bold bg-gray-100 text-gray-700 px-2 py-0.5 rounded">Lower = Better</span>
          </div>
          <p class="text-[11px] text-gray-500 mt-1">Germany (1.0 best – 4.0 pass), Austria (1–5), Czechia / Slovakia (1–4)</p>
        </button>
      </div>
    </section>

    <!-- Step 2: Country Preset + Destination English-Speaking Country -->
    <div class="bg-white rounded-2xl border border-gray-200 p-5 shadow-sm grid grid-cols-1 md:grid-cols-11 gap-4 items-center">
      <!-- Specific Home Country Preset -->
      <div class="md:col-span-5">
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Step 2A: Specific Country / University Preset</label>
        <select id="fromCountry" onchange="applyFromCountry()" class="w-full rounded-xl border border-gray-300 bg-gray-50 px-3.5 py-3 text-sm font-bold text-gray-900 focus:border-orange-500 focus:bg-white focus:outline-none"></select>
      </div>

      <!-- Arrow -->
      <div class="md:col-span-1 flex justify-center pt-4">
        <div class="w-10 h-10 rounded-full bg-orange-50 border border-orange-200 text-orange-600 font-extrabold flex items-center justify-center">
          →
        </div>
      </div>

      <!-- Target English-Speaking Destination -->
      <div class="md:col-span-5">
        <label class="block text-xs font-bold uppercase tracking-wider text-orange-600 mb-1.5">Step 2B: Target English-Speaking Study Country</label>
        <select id="toCountry" onchange="calculateAll()" class="w-full rounded-xl border-2 border-orange-400 bg-orange-50/40 px-3.5 py-3 text-sm font-bold text-gray-900 focus:border-orange-500 focus:bg-white focus:outline-none">
          <option value="uk">🇬🇧 United Kingdom — Honours Class (1st, 2:1, 2:2) & UK CATS Credits</option>
          <option value="usa">🇺🇸 United States — 4.0 GPA Scale & US Semester Credits</option>
          <option value="canada">🇨🇦 Canada — 4.0 / 4.33 GPA, Letter Grade & Canadian Credits</option>
          <option value="australia">🇦🇺 Australia — 7.0 GPA (HD, D, Cr, P) & AU Credit Points</option>
          <option value="ireland">🇮🇪 Ireland — NQAI Honours (1H, 2H1, 2H2) & ECTS Credits</option>
          <option value="nz">🇳🇿 New Zealand — 9.0 GPA Scale (A+ to C-) & NZ Credits</option>
          <option value="singapore">🇸🇬 Singapore — 5.0 CAP / GPA Scale & Modular Credits (MCs)</option>
        </select>
      </div>
    </div>

    <!-- Step 3: Interactive Inputs & Live Conversion Results -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- Left Column: Score, Grading Rigor (Absolute vs Relative), Semesters & Credits -->
      <div class="lg:col-span-6 space-y-5">

        <!-- Card A: Score & Grading Policy -->
        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-gray-100 pb-2.5">
            <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500">Your Score & Scale Bounds</h2>
            <span id="fromSystemBadge" class="text-[11px] font-semibold bg-orange-50 text-orange-700 border border-orange-200 px-2.5 py-0.5 rounded-full">GPA / Letter Scale</span>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Max Grade (Nmax)</label>
              <input type="number" id="nMax" value="4.0" step="0.01" oninput="calculateAll()" class="w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm font-bold text-gray-900 focus:border-orange-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Min Pass (Nmin)</label>
              <input type="number" id="nMin" value="2.0" step="0.01" oninput="calculateAll()" class="w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm font-bold text-gray-900 focus:border-orange-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-bold text-orange-600 mb-1">Your Score (Nd)</label>
              <input type="number" id="nObtained" value="3.45" step="0.01" oninput="calculateAll()" class="w-full rounded-xl border-2 border-orange-400 bg-orange-50/40 px-3 py-2.5 text-sm font-extrabold text-gray-900 focus:border-orange-500 focus:outline-none" />
            </div>
          </div>

          <!-- Cross-System Concept: Absolute vs Relative Grading Toggle -->
          <div class="pt-2 border-t border-gray-100">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-gray-700">Institutional Grading Policy</span>
              <span class="text-[11px] text-gray-400">Cross-System Context</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" id="policy-absolute" onclick="setGradingPolicy('absolute')" class="py-2 px-3 rounded-xl border-2 border-orange-500 bg-orange-50/50 text-xs font-bold text-gray-900 text-left">
                <div>Absolute Grading</div>
                <div class="text-[10px] font-normal text-gray-500">Fixed score cut-offs</div>
              </button>
              <button type="button" id="policy-relative" onclick="setGradingPolicy('relative')" class="py-2 px-3 rounded-xl border border-gray-200 bg-white text-xs font-bold text-gray-700 text-left hover:border-orange-300">
                <div>Relative (Bell Curve)</div>
                <div class="text-[10px] font-normal text-gray-500">Norm-referenced cohort rank</div>
              </button>
            </div>
            <p id="policyExplainer" class="text-[11px] text-gray-500 mt-2 leading-relaxed">
              <strong>Absolute Grading:</strong> Your raw score is evaluated against fixed institutional boundaries without cohort curve adjustment.
            </p>
          </div>

          <div id="validationAlert" class="hidden rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs font-medium text-red-700"></div>
        </div>

        <!-- Card B: Semesters, Credit Hours & Study Workload -->
        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-gray-100 pb-2.5">
            <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500">Semesters, Credit Hours & Study Workload</h2>
            <span class="text-[11px] font-semibold text-orange-600">Degree Duration</span>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Semesters Done</label>
              <input type="number" id="numSemesters" value="8" min="1" max="16" oninput="calculateAll()" class="w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm font-bold text-gray-900 focus:border-orange-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Total Credits</label>
              <input type="number" id="totalCredits" value="136" min="1" max="400" oninput="calculateAll()" class="w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm font-bold text-gray-900 focus:border-orange-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Weeks / Sem</label>
              <input type="number" id="weeksPerSem" value="16" min="8" max="24" oninput="calculateAll()" class="w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm font-bold text-gray-900 focus:border-orange-500 focus:outline-none" />
            </div>
          </div>

          <p id="homeCreditExplainer" class="text-[11px] text-gray-500 bg-gray-50 border border-gray-200 rounded-xl p-3 leading-relaxed"></p>
        </div>

      </div>

      <!-- Right Column: Converted Grade + ECTS Bridge + Credits & Student Visa Work Hours -->
      <div class="lg:col-span-6 flex flex-col gap-5">

        <!-- Primary Target Country Grade Card -->
        <div class="bg-white rounded-2xl border-2 border-orange-500 p-6 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>
              <span id="targetCountryBadge" class="inline-block text-[11px] font-bold uppercase tracking-wider bg-orange-100 text-orange-700 px-2.5 py-0.5 rounded-full mb-2">
                🇬🇧 United Kingdom — Honours Classification
              </span>
              <div class="flex items-baseline gap-3 flex-wrap">
                <span id="convertedGradeBig" class="text-4xl sm:text-5xl font-extrabold text-gray-900">First (1st)</span>
                <span id="convertedClassification" class="text-sm font-bold text-emerald-600">First-Class Honours (1st) (~75% UK equiv.)</span>
              </div>
              <p id="targetAdmissionNote" class="text-xs text-gray-500 mt-1.5">Most Russell Group & UK Master’s programs require a 2:1 (Upper Second-Class) or strong 2:2.</p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button onclick="copyFullReport()" id="copyBtn" class="px-3 py-2 rounded-xl border border-gray-200 hover:border-orange-300 hover:bg-orange-50 text-xs font-semibold text-gray-700 transition">
                Copy Text
              </button>
              <button onclick="openPdfModal()" class="px-3.5 py-2 rounded-xl bg-orange-500 hover:bg-orange-600 text-xs font-bold text-white shadow-sm transition flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <span>PDF Report</span>
              </button>
            </div>
          </div>

          <!-- Cross-System ECTS & Formula Strip -->
          <div class="mt-4 pt-3 border-t border-gray-100 flex flex-wrap items-center justify-between gap-2 text-[11px]">
            <span id="formulaUsedBox" class="font-mono text-gray-600">UK ENIC Equivalence Mapping</span>
            <span id="ectsBridgeBadge" class="font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 px-2.5 py-0.5 rounded-full">
              ECTS Equivalent: Grade A (Top 10%)
            </span>
          </div>
        </div>

        <!-- Converted Credits, Study Workload & Official Student Working Hours -->
        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm space-y-4 flex-1">
          <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500">Converted Credits, Study Workload & Student Work Hours</h3>

          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-orange-50/60 border border-orange-200 p-3.5">
              <div id="targetCreditLabel" class="text-[11px] font-semibold text-orange-700">Converted UK CATS Credits</div>
              <div id="convertedCreditsVal" class="text-lg font-extrabold text-gray-900 mt-0.5">480 UK Credits</div>
              <div id="creditsPerSemVal" class="text-[11px] text-gray-500 mt-0.5">~60.0 UK Credits / semester</div>
            </div>

            <div class="rounded-xl bg-gray-50 border border-gray-200 p-3.5">
              <div class="text-[11px] font-semibold text-gray-500">Total Academic Study Hours</div>
              <div id="totalStudyHoursVal" class="text-lg font-extrabold text-gray-900 mt-0.5">6,120 hrs</div>
              <div id="weeklyStudyHoursVal" class="text-[11px] text-gray-500 mt-0.5">~47.8 hrs/week (contact + self)</div>
            </div>

            <div class="rounded-xl bg-emerald-50/70 border border-emerald-200 p-3.5 col-span-2">
              <div class="flex items-center justify-between">
                <span id="workHoursTitle" class="text-xs font-bold text-emerald-800">🇬🇧 Legal Student Working Hours in UK</span>
                <span class="text-[10px] font-bold uppercase bg-emerald-600 text-white px-2 py-0.5 rounded">Visa Rule</span>
              </div>
              <div id="workHoursMain" class="text-sm font-extrabold text-gray-900 mt-1"></div>
              <p id="workHoursNote" class="text-[11px] text-gray-600 mt-1"></p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- All 7 English-Speaking Destinations + ECTS Live Comparison Grid -->
    <div class="bg-white rounded-2xl border border-gray-200 p-5 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500">Instant English-Speaking Study Destinations & ECTS Comparison</h3>
        <span class="text-[11px] text-gray-400">Updates automatically as you type</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2.5 text-center">
        <div class="p-3 rounded-xl bg-gray-50 border border-gray-100">
          <div class="text-[11px] text-gray-500 font-semibold">🇬🇧 UK Class</div>
          <div id="snapUk" class="text-sm font-extrabold text-orange-600 mt-1">First (1st)</div>
        </div>
        <div class="p-3 rounded-xl bg-gray-50 border border-gray-100">
          <div class="text-[11px] text-gray-500 font-semibold">🇺🇸 USA 4.0</div>
          <div id="snapUs" class="text-base font-extrabold text-gray-900 mt-0.5">3.45</div>
        </div>
        <div class="p-3 rounded-xl bg-gray-50 border border-gray-100">
          <div class="text-[11px] text-gray-500 font-semibold">🇨🇦 Canada</div>
          <div id="snapCa" class="text-sm font-extrabold text-gray-900 mt-1">3.45 (A-)</div>
        </div>
        <div class="p-3 rounded-xl bg-gray-50 border border-gray-100">
          <div class="text-[11px] text-gray-500 font-semibold">🇦🇺 Australia</div>
          <div id="snapAu" class="text-sm font-extrabold text-gray-900 mt-1">6.0 / 7.0</div>
        </div>
        <div class="p-3 rounded-xl bg-gray-50 border border-gray-100">
          <div class="text-[11px] text-gray-500 font-semibold">🇮🇪 Ireland</div>
          <div id="snapIe" class="text-sm font-extrabold text-gray-900 mt-1">1H</div>
        </div>
        <div class="p-3 rounded-xl bg-gray-50 border border-gray-100">
          <div class="text-[11px] text-gray-500 font-semibold">🇳🇿 NZ 9.0</div>
          <div id="snapNz" class="text-sm font-extrabold text-gray-900 mt-1">7.2 / 9.0</div>
        </div>
        <div class="p-3 rounded-xl bg-gray-50 border border-gray-100">
          <div class="text-[11px] text-gray-500 font-semibold">🇸🇬 Singapore</div>
          <div id="snapSg" class="text-sm font-extrabold text-gray-900 mt-1">4.3 / 5.0</div>
        </div>
        <div class="p-3 rounded-xl bg-indigo-50/70 border border-indigo-100">
          <div class="text-[11px] text-indigo-700 font-semibold">🇪🇺 ECTS Band</div>
          <div id="snapEcts" class="text-sm font-extrabold text-indigo-900 mt-1">Grade A</div>
        </div>
      </div>
    </div>

    <!-- Contextual University-Tutors.com Conversion Banner -->
    <div class="bg-gradient-to-r from-orange-50 via-amber-50 to-orange-50 rounded-2xl border border-orange-200 p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <span class="text-[11px] font-bold uppercase tracking-wider text-orange-600">International Admissions & Language Prep</span>
        <h3 class="text-base font-bold text-gray-900 mt-0.5">Applying to Universities in the UK, USA, Canada, Australia, or Ireland?</h3>
        <p class="text-xs text-gray-600 mt-0.5">Get 1-on-1 help with transcript evaluation, SOP/CV review, IELTS/PTE prep, and subject tutoring on University-Tutors.com.</p>
      </div>
      <div class="flex items-center gap-2.5 shrink-0">
        <button onclick="openPdfModal()" class="px-4 py-2.5 rounded-xl border border-orange-300 bg-white hover:bg-orange-50 text-orange-700 text-xs font-bold transition">
          Generate Branded PDF
        </button>
        <a href="#book-admission-tutor" class="px-5 py-2.5 rounded-xl bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold shadow-sm transition">
          Book 1-on-1 Guidance →
        </a>
      </div>
    </div>

  </main>

  <!-- PDF Report Customization Modal -->
  <div id="pdfModal" class="hidden fixed inset-0 z-50 bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl border border-gray-200 max-w-md w-full p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-orange-500 text-white font-extrabold flex items-center justify-center text-sm">U</div>
          <div>
            <h3 class="text-sm font-extrabold text-gray-900">Official Branded PDF Report</h3>
            <p class="text-[11px] text-gray-500">University-Tutors.com Academic Credential Summary</p>
