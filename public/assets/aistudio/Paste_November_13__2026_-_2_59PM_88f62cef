    function getCurrentPreset() {
      const list = PRESETS_BY_ARCHETYPE[currentArchetype];
      const selectedId = document.getElementById('fromCountry').value;
      return list.find(x => x.id === selectedId) || list[0];
    }

    function applyFromCountry() {
      const sys = getCurrentPreset();
      document.getElementById('fromSystemBadge').textContent = sys.badge;
      document.getElementById('nMax').value = sys.max;
      document.getElementById('nMin').value = sys.min;
      document.getElementById('nObtained').value = sys.sample;
      document.getElementById('numSemesters').value = sys.semesters;
      document.getElementById('totalCredits').value = sys.credits;
      document.getElementById('weeksPerSem').value = sys.weeks;
      document.getElementById('homeCreditExplainer').innerHTML = `<strong>System Credit & Workload Standard:</strong> ${sys.explainer}`;
      calculateAll();
    }

    function setGradingPolicy(policy) {
      gradingPolicy = policy;
      const absBtn = document.getElementById('policy-absolute');
      const relBtn = document.getElementById('policy-relative');
      const exp = document.getElementById('policyExplainer');

      if (policy === 'relative') {
        relBtn.className = 'py-2 px-3 rounded-xl border-2 border-orange-500 bg-orange-50/50 text-xs font-bold text-gray-900 text-left';
        absBtn.className = 'py-2 px-3 rounded-xl border border-gray-200 bg-white text-xs font-bold text-gray-700 text-left hover:border-orange-300';
        exp.innerHTML = '<strong>Relative (Bell-Curve) Grading:</strong> Because only the top cohort percentile earns top grades under curve grading, admissions evaluators apply a slight upward competitiveness buffer (+4% cohort rank weight).';
      } else {
        absBtn.className = 'py-2 px-3 rounded-xl border-2 border-orange-500 bg-orange-50/50 text-xs font-bold text-gray-900 text-left';
        relBtn.className = 'py-2 px-3 rounded-xl border border-gray-200 bg-white text-xs font-bold text-gray-700 text-left hover:border-orange-300';
        exp.innerHTML = '<strong>Absolute Grading:</strong> Your raw score is evaluated directly against fixed institutional thresholds without cohort curve adjustment.';
      }
      calculateAll();
    }

    function calculateAll() {
      const sys = getCurrentPreset();
      const toKey = document.getElementById('toCountry').value;
      const target = TARGET_COUNTRIES[toKey];

      const nMax = parseFloat(document.getElementById('nMax').value);
      const nMin = parseFloat(document.getElementById('nMin').value);
      const nObt = parseFloat(document.getElementById('nObtained').value);
      const alertBox = document.getElementById('validationAlert');

      const isInverted = sys.inverted === true;
      if (isNaN(nMax) || isNaN(nMin) || isNaN(nObt)) return;

      if (!isInverted && (nMax <= nMin || nObt > nMax || nObt < 0)) {
        alertBox.textContent = `Please enter a valid score between 0 and ${nMax} (with Max Grade > Min Pass ${nMin}).`;
        alertBox.classList.remove('hidden');
        return;
      }
      if (isInverted && (nObt < nMax || nObt > (nMin + 1))) {
        alertBox.textContent = `In inverted scales, enter a value between ${nMax} (highest) and ${nMin + 1} (fail).`;
        alertBox.classList.remove('hidden');
        return;
      }
      alertBox.classList.add('hidden');

      // Normalize passing performance ratio (0 = minimum pass, 1 = top possible score)
      let passProgress;
      if (isInverted) {
        passProgress = Math.max(0, Math.min(1, (nMin - nObt) / (nMin - nMax)));
      } else {
        passProgress = (nObt - nMin) / (nMax - nMin);
      }

      // Apply subtle cohort curve recognition if Relative Grading is selected
      if (gradingPolicy === 'relative' && passProgress >= 0) {
        passProgress = Math.min(1.0, passProgress + 0.04);
      }

      const germanVal = Math.max(1.0, Math.min(5.0, 1 + 3 * (1 - passProgress)));
      const pctVal = Math.max(0, Math.min(100, isInverted ? (100 - (germanVal - 1) * 15) : (nObt / nMax) * 100));
      const us4Val = Math.max(0, Math.min(4.0, passProgress >= 0 ? 2.0 + 2.0 * passProgress : Math.max(0, (nObt / nMin) * 2.0)));

      // ECTS Letter Grade Equivalence (Cross-System Concept)
      let ectsBand = 'Grade E (Sufficient)';
      let ectsShort = 'Grade E';
      if (passProgress < 0) { ectsBand = 'Grade F / FX (Fail)'; ectsShort = 'Fail (F)'; }
      else if (passProgress >= 0.82) { ectsBand = 'ECTS Grade A (Top 10%)'; ectsShort = 'Grade A'; }
      else if (passProgress >= 0.65) { ectsBand = 'ECTS Grade B (Next 25%)'; ectsShort = 'Grade B'; }
      else if (passProgress >= 0.45) { ectsBand = 'ECTS Grade C (Next 30%)'; ectsShort = 'Grade C'; }
      else if (passProgress >= 0.25) { ectsBand = 'ECTS Grade D (Next 25%)'; ectsShort = 'Grade D'; }

      document.getElementById('ectsBridgeBadge').textContent = ectsBand;
      document.getElementById('snapEcts').textContent = ectsShort;

      // Update Target Country Headers & Visa Work Hours
      document.getElementById('targetCountryBadge').textContent = target.badge;
      document.getElementById('targetCreditLabel').textContent = target.creditLabel;
      document.getElementById('workHoursTitle').textContent = target.workTitle;
      document.getElementById('workHoursMain').textContent = target.workMain;
      document.getElementById('workHoursNote').textContent = target.workNote;

      const bigEl = document.getElementById('convertedGradeBig');
      const classEl = document.getElementById('convertedClassification');
      const noteEl = document.getElementById('targetAdmissionNote');
      const formulaEl = document.getElementById('formulaUsedBox');

      const au7Val = (4.0 + Math.max(0, passProgress) * 3.0).toFixed(2);
      const nz9Val = (1.0 + Math.max(0, passProgress) * 8.0).toFixed(2);
      const sg5Val = (2.0 + Math.max(0, passProgress) * 3.0).toFixed(2);

      let ukShort = '3rd', ukFull = 'Third-Class Honours (3rd)', ukPct = Math.round(40 + Math.max(0, passProgress) * 45);
      if (passProgress < 0) { ukShort = 'Fail'; ukFull = 'Below Honours Pass'; }
      else if (germanVal <= 1.6) { ukShort = 'First (1st)'; ukFull = 'First-Class Honours (1st)'; }
      else if (germanVal <= 2.4) { ukShort = '2:1 Class'; ukFull = 'Upper Second-Class Honours (2:1)'; }
      else if (germanVal <= 3.2) { ukShort = '2:2 Class'; ukFull = 'Lower Second-Class Honours (2:2)'; }

      if (toKey === 'uk') {
        bigEl.textContent = ukShort;
        classEl.textContent = `${ukFull} (~${ukPct}% UK equiv.)`;
        formulaEl.textContent = `UK ENIC Equivalence from ${nObt}/${nMax} (${gradingPolicy === 'relative' ? 'Bell-Curve Adjusted' : 'Absolute'})`;
        noteEl.textContent = 'Most Russell Group & UK Master’s programs require a 2:1 (Upper Second-Class) or strong 2:2.';
      } else if (toKey === 'usa') {
        bigEl.textContent = `${us4Val.toFixed(2)} / 4.0`;
        classEl.textContent = us4Val >= 3.7 ? 'Summa / Magna Cum Laude (A)' : us4Val >= 3.3 ? 'Dean’s List Standing (B+/A-)' : us4Val >= 3.0 ? 'Good Graduate Standing (B)' : 'Passing Standing';
        formulaEl.textContent = `WES Passing Normalization: 2.0 + 2.0 × Pass Ratio (${(Math.max(0, passProgress) * 100).toFixed(0)}%)`;
        noteEl.textContent = 'US universities typically require a minimum 3.00 / 4.00 GPA (and 3.5+ for top PhD/fellowship funding).';
      } else if (toKey === 'canada') {
        const caLetter = us4Val >= 3.8 ? 'A / A+' : us4Val >= 3.5 ? 'A-' : us4Val >= 3.0 ? 'B+' : us4Val >= 2.7 ? 'B' : 'C+';
        bigEl.textContent = `${us4Val.toFixed(2)} / 4.0`;
        classEl.textContent = `Canadian Grade ${caLetter} (~${Math.round(50 + Math.max(0, passProgress) * 42)}%)`;
        formulaEl.textContent = `Canadian 4.0 Scale Conversion (B+ = 3.30, A- = 3.70, A = 4.00)`;
        noteEl.textContent = 'Most Canadian Master’s programs (UofT, UBC, Waterloo) require at least a B+ (3.30/4.0) in the final 2 years.';
      } else if (toKey === 'australia') {
        const label = au7Val >= 6.5 ? 'High Distinction (HD)' : au7Val >= 5.5 ? 'Distinction (D)' : au7Val >= 4.5 ? 'Credit (Cr)' : 'Pass (P)';
        bigEl.textContent = `${au7Val} / 7.0`;
        classEl.textContent = label;
        formulaEl.textContent = `Australian 7.0 Descriptive Band Scale (4.0 Pass → 7.0 High Distinction)`;
        noteEl.textContent = 'Group of Eight (Go8) Australian universities typically require a Credit (5.0+) or Distinction (6.0+) average.';
      } else if (toKey === 'ireland') {
        const ieGrade = passProgress < 0 ? 'Fail' : germanVal <= 1.6 ? '1H (First-Class Honours)' : germanVal <= 2.4 ? '2H1 (Second-Class, Grade 1)' : germanVal <= 3.2 ? '2H2 (Second-Class, Grade 2)' : 'Pass';
        bigEl.textContent = ieGrade.split(' ')[0];
        classEl.textContent = ieGrade;
        formulaEl.textContent = `Irish NQAI Honours Framework (1H ≥ 70%, 2H1 = 60–69%, 2H2 = 50–59%)`;
        noteEl.textContent = 'Trinity College Dublin, UCD, and University of Galway generally require a 2H1 (Upper Second-Class) for Master’s entry.';
      } else if (toKey === 'nz') {
        const nzLetter = nz9Val >= 8.0 ? 'A+ / A (First Class)' : nz9Val >= 6.5 ? 'A- / B+ (Second Div 1)' : nz9Val >= 5.0 ? 'B / B- (Second Div 2)' : 'C+ / C (Pass)';
        bigEl.textContent = `${nz9Val} / 9.0`;
        classEl.textContent = nzLetter;
        formulaEl.textContent = `New Zealand 9.0 Scale (9 = A+, 8 = A, 7 = A-, 6 = B+, 5 = B, 1 = C- Pass)`;
        noteEl.textContent = 'University of Auckland and Otago typically require a B or B+ average (5.0–6.0 / 9.0) for postgraduate admission.';
      } else if (toKey === 'singapore') {
        const sgClass = sg5Val >= 4.5 ? 'Honours (Highest Distinction)' : sg5Val >= 4.0 ? 'Honours (Distinction)' : sg5Val >= 3.5 ? 'Honours (Merit)' : 'Pass';
        bigEl.textContent = `${sg5Val} / 5.0`;
        classEl.textContent = sgClass;
        formulaEl.textContent = `Singapore 5.0 CAP Scale (5.0 = A+/A, 4.5 = A-, 4.0 = B+, 3.5 = B, 2.0 = Pass)`;
        noteEl.textContent = 'NUS & NTU postgraduate programs typically look for at least Honours (Distinction) / 4.0+ out of 5.0.';
      }

      // Credits & Study Workload Hours Calculations
      const sems = Math.max(1, parseInt(document.getElementById('numSemesters').value) || 8);
      const credits = Math.max(1, parseFloat(document.getElementById('totalCredits').value) || 136);
      const weeks = Math.max(1, parseInt(document.getElementById('weeksPerSem').value) || 16);

      const estEcts = credits * sys.ectsMultiplier;
      const targetCredits = Math.round(estEcts * target.ectsFactor);
      const perSemCredits = (targetCredits / sems).toFixed(1);

      const totalStudyHrs = Math.round(credits * sys.hoursPerCredit);
      const weeklyStudyHrs = (totalStudyHrs / (sems * weeks)).toFixed(1);

      document.getElementById('convertedCreditsVal').textContent = `${targetCredits} ${target.creditUnit}`;
      document.getElementById('creditsPerSemVal').textContent = `~${perSemCredits} ${target.creditUnit} / semester (${sems} sems)`;
      document.getElementById('totalStudyHoursVal').textContent = `${totalStudyHrs.toLocaleString()} hrs`;
      document.getElementById('weeklyStudyHoursVal').textContent = `~${weeklyStudyHrs} hrs/week (${weeks} wks/sem)`;

      // Update Bottom English-Speaking Snapshot
      document.getElementById('snapUk').textContent = ukShort;
      document.getElementById('snapUs').textContent = `${us4Val.toFixed(2)}`;
      document.getElementById('snapCa').textContent = `${us4Val.toFixed(2)} (${us4Val >= 3.5 ? 'A-' : 'B+'})`;
      document.getElementById('snapAu').textContent = `${au7Val} / 7.0`;
      document.getElementById('snapIe').textContent = passProgress < 0 ? 'Fail' : germanVal <= 1.6 ? '1H' : germanVal <= 2.4 ? '2H1' : '2H2';
      document.getElementById('snapNz').textContent = `${nz9Val} / 9.0`;
      document.getElementById('snapSg').textContent = `${sg5Val} / 5.0`;
    }

    function copyFullReport() {
