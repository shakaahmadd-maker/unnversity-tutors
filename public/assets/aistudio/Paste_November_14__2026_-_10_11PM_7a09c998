    <script>
        function sortAllelePair(a1, a2) {
            if (a1 === a2) return a1 + a2;
            if (a1.toUpperCase() === a2.toUpperCase()) {
                return a1 === a1.toUpperCase() ? a1 + a2 : a2 + a1;
            }
            return [a1, a2].sort().join('');
        }

        function renderStaticDihybridInfographic() {
            const gametes = ['AB', 'Ab', 'aB', 'ab'];
            const tbody = document.getElementById('static-dihybrid-visual-body');
            let html = '';

            gametes.forEach(rowG => {
                html += `<tr>
                    <td class="p-2 border border-brand-200 bg-brand-50 font-mono font-bold text-brand-800">${rowG}</td>`;
                gametes.forEach(colG => {
                    const t1 = sortAllelePair(colG[0], rowG[0]);
                    const t2 = sortAllelePair(colG[1], rowG[1]);
                    const geno = t1 + t2;
                    const isRound = /[A-Z]/.test(t1);
                    const isYellow = /[A-Z]/.test(t2);

                    let peaVisual = '';
                    let label = '';
                    let cellBg = '';

                    if (isRound && isYellow) {
                        peaVisual = `<span class="inline-block w-6 h-6 rounded-full bg-gradient-to-br from-yellow-300 to-amber-500 border border-amber-600 shadow-sm"></span>`;
                        label = 'Round, Yellow';
                        cellBg = 'bg-orange-50/40';
                    } else if (isRound && !isYellow) {
                        peaVisual = `<span class="inline-block w-6 h-6 rounded-full bg-gradient-to-br from-lime-400 to-green-600 border border-green-700 shadow-sm"></span>`;
                        label = 'Round, Green';
                        cellBg = 'bg-white';
                    } else if (!isRound && isYellow) {
                        peaVisual = `<span class="inline-block w-6 h-6 rounded-full bg-amber-400 border-2 border-dashed border-amber-700 shadow-sm"></span>`;
                        label = 'Wrinkled, Yellow';
                        cellBg = 'bg-amber-50/50';
                    } else {
                        peaVisual = `<span class="inline-block w-6 h-6 rounded-full bg-green-500 border-2 border-dashed border-green-800 shadow-sm"></span>`;
                        label = 'Wrinkled, Green';
                        cellBg = 'bg-brand-50/60';
                    }

                    html += `<td class="p-2 border border-brand-200 ${cellBg}">
                        <div class="font-mono font-bold text-slate-900 text-xs">${geno}</div>
                        <div class="my-1">${peaVisual}</div>
                        <div class="text-[9px] font-medium text-slate-600 leading-tight">${label}</div>
                    </td>`;
                });
                html += `</tr>`;
            });
            tbody.innerHTML = html;
        }

        window.addEventListener('DOMContentLoaded', renderStaticDihybridInfographic);
    </script>
