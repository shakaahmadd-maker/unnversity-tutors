<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Why Students Trust Us For Success - Mobile Redesign | University Tutors</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['"Plus Jakarta Sans"', 'sans-serif'],
            body: ['"Inter"', 'sans-serif'],
          },
          colors: {
            brand: {
              orange: '#f59e0b',
              orangeDark: '#d97706',
              navy: '#0d1b2a',
              navyLight: '#1b2a47',
              navyMuted: '#243454',
              surface: '#f8fafc',
            }
          },
          boxShadow: {
            'card': '0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04)',
            'card-hover': '0 20px 30px -10px rgba(245, 158, 11, 0.2), 0 10px 10px -5px rgba(15, 23, 42, 0.04)',
            'thumb': '0 4px 14px 0 rgba(245, 158, 11, 0.39)',
          }
        }
      }
    }
  </script>
  <style>
    /* Smooth native touch feeling */
    * {
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    /* Horizontal snap carousel */
    .snap-carousel {
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
    }
    .snap-item {
      scroll-snap-align: center;
      scroll-snap-stop: always;
    }
    /* Active touch response */
    .tap-bounce:active {
      transform: scale(0.97);
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-800 font-body min-h-screen antialiased flex flex-col items-center justify-start sm:py-6">

  <!-- Desktop Presentation Wrapper Bar -->
