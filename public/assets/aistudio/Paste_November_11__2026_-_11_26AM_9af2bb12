        </svg>
      </button>
      <button onclick="openCustomQuoteModal()" class="flex-1 h-12 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-display font-extrabold text-xs shadow-thumb flex items-center justify-center gap-2 tap-bounce px-3">
        <span>Talk to an Expert Tutor Now</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

  </div>

  <!-- INTERACTIVE BOTTOM SHEET / CARD MODAL (NO ALERT/CONFIRM) -->
  <div id="detailBottomSheet" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs flex items-end justify-center hidden transition-opacity">
    <div class="bg-white w-full max-w-[430px] rounded-t-3xl p-5 space-y-4 shadow-2xl animate-slide-up transform transition-all max-h-[85vh] overflow-y-auto">
      
