        </div>
        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-1">Assistance Needed</label>
          <select id="selectCourseScope" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-800 focus:outline-none focus:border-amber-500 text-xs">
            <option>Full Class (Discussions + Quizzes + Exams)</option>
            <option>Individual Exam or Midterm</option>
            <option>Essay, Research Paper or Lab</option>
            <option>Weekly Homework Assignments</option>
