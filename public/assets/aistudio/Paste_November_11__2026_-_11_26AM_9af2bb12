          <div class="pt-3 px-0.5 mt-2.5 border-t border-slate-100 flex items-center justify-between">
            <button onclick="openCardDetail(${card.id})" class="text-amber-500 hover:text-amber-600 font-display font-black text-xs uppercase tracking-wider flex items-center gap-1 tap-bounce group py-1">
              <span>LEARN MORE</span>
              <span class="text-amber-500 font-bold group-hover:translate-x-1.5 transition-transform text-sm">→</span>
            </button>
            
            <button onclick="openCustomQuoteModal('Course Help for: ${card.title}')" class="text-[10px] font-bold text-slate-600 hover:text-slate-900 bg-slate-50 px-2.5 py-1 rounded-lg border border-slate-200/80 tap-bounce">
              Get Quote
            </button>
          </div>

        </article>
      `).join('');
    }

    // Detail Drawer Modal Logic
    function openCardDetail(id) {
      const card = cardsData.find(c => c.id === id);
      if (!card) return;
      selectedCardForModal = card;

      document.getElementById('modalTitle').innerText = card.title;
      document.getElementById('modalCategory').innerText = card.categoryLabel;
      document.getElementById('modalIconContainer').innerHTML = card.badgeIcon;
      document.getElementById('modalImage').src = card.img;
      document.getElementById('modalDesc').innerText = card.desc;

      const benefitsList = document.getElementById('modalBenefits');
      benefitsList.innerHTML = card.extraPoints.map(p => `
        <li class="flex items-start gap-1.5">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>${p}</span>
        </li>
      `).join('');

      document.getElementById('detailBottomSheet').classList.remove('hidden');
    }

    function closeBottomSheet() {
      document.getElementById('detailBottomSheet').classList.add('hidden');
    }

    function requestHelpForCurrentCard() {
      closeBottomSheet();
      openCustomQuoteModal(`Inquiry regarding: ${selectedCardForModal.title}`);
    }

    // Quote Modal Handlers
    function openCustomQuoteModal(prefMessage) {
      const modal = document.getElementById('quoteModal');
      modal.classList.remove('hidden');
      if (prefMessage) {
        document.getElementById('inputCourseCode').value = prefMessage;
      }
    }

    function closeQuoteModal() {
      document.getElementById('quoteModal').classList.add('hidden');
    }

    function confirmSubmitQuote() {
      const course = document.getElementById('inputCourseCode').value.trim();
      closeQuoteModal();
      showToast(course ? `Quote request received for ${course}!` : `Quote request dispatched to available tutors!`);
    }

    function openContactModal(channel) {
      showToast(`Connecting with a 24/7 Academic Advisor via ${channel}...`);
    }

    function showToast(msg) {
      const toast = document.getElementById('mobileToast');
      const text = document.getElementById('toastMsg');
      text.innerText = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 3500);
    }

    // Desktop presentation toggle
    function setDeviceView(mode) {
      const shell = document.getElementById('deviceShell');
      const phoneBtn = document.getElementById('viewPhoneBtn');
      const responsiveBtn = document.getElementById('viewResponsiveBtn');

      if (mode === 'phone') {
        shell.className = 'w-full max-w-[430px] bg-slate-50 relative transition-all duration-300 shadow-2xl sm:rounded-b-[2.5rem] overflow-hidden border border-slate-800/20';
        phoneBtn.className = 'px-2.5 py-1 rounded-lg font-bold bg-amber-500 text-slate-950 transition-all flex items-center gap-1';
        responsiveBtn.className = 'px-2.5 py-1 rounded-lg font-medium text-slate-400 hover:text-white transition-all flex items-center gap-1';
      } else {
        shell.className = 'w-full max-w-2xl bg-slate-50 relative transition-all duration-300 shadow-2xl sm:rounded-b-[2.5rem] overflow-hidden border border-slate-800/20';
        responsiveBtn.className = 'px-2.5 py-1 rounded-lg font-bold bg-amber-500 text-slate-950 transition-all flex items-center gap-1';
        phoneBtn.className = 'px-2.5 py-1 rounded-lg font-medium text-slate-400 hover:text-white transition-all flex items-center gap-1';
      }
    }
  </script>
</body>
</html>