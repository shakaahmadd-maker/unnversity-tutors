            UNIVERSITY<span class="text-amber-500">TUTORS</span>
          </h2>
          <p class="text-[10px] text-slate-500 font-medium mt-0.5">Online Class Assistance</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <a href="javascript:void(0)" onclick="openContactModal('Direct Call')" class="flex items-center gap-1 text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-1 rounded-full tap-bounce">
