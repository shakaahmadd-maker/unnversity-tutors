        </div>
        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-1">Where to send the quote?</label>
          <input id="inputContact" type="text" placeholder="WhatsApp Number or Student Email" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-slate-800 focus:outline-none focus:border-amber-500 text-xs">
        </div>
      </div>

      <div class="pt-2 flex gap-2">
        <button onclick="confirmSubmitQuote()" class="flex-1 py-3 rounded-xl font-display font-bold text-xs bg-amber-500 hover:bg-amber-600 text-slate-950 shadow-md tap-bounce">
          Send Me The Binding Quote
        </button>
        <button onclick="closeQuoteModal()" class="py-3 px-3 rounded-xl bg-slate-100 text-slate-600 font-semibold text-xs tap-bounce">
          Cancel
        </button>
      </div>
    </div>
  </div>

  <!-- SAFE IN-APP TOAST NOTIFICATION (No native alert) -->
  <div id="mobileToast" class="fixed top-5 left-1/2 -translate-x-1/2 bg-[#0d1b2a] text-white px-4 py-2.5 rounded-2xl text-xs font-semibold shadow-2xl z-50 transition-all opacity-0 pointer-events-none flex items-center gap-2 border border-slate-700">
    <span class="text-amber-400">✨</span>
    <span id="toastMsg">Action completed successfully</span>
  </div>

  <!-- CORE SCRIPT LOGIC -->
  <script>
    // 6 Cards exactly extracted from user screenshots
    const cardsData = [
      {
        id: 1,
        title: "Instant Help When You Need It",
        badgeIcon: `<svg class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
