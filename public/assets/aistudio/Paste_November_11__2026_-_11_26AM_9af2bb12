        extraPoints: [
          "Specialists matched directly by subject: STEM, Healthcare, Business",
          "Guaranteed A or B academic performance policy",
          "100% human-crafted papers with zero AI & Turnitin reports"
        ]
      },
      {
        id: 5,
        title: "Real-Time Progress Monitoring",
        badgeIcon: `<svg class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>`,
        category: "experts",
        categoryLabel: "Live Dashboard",
        img: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=700&q=80",
        desc: "Stay on top of your academic performance with a live progress dashboard that helps you track assignments, deadlines, and improvements.",
