    let selectedCardForModal = cardsData[0];

    window.onload = function() {
      renderVerticalCards();
    };

    // Render 6 Cards in a clean, vertical stream
    function renderVerticalCards() {
      const container = document.getElementById('verticalCardsStream');

      container.innerHTML = cardsData.map((card, index) => `
        <article class="bg-white rounded-2xl sm:rounded-3xl p-3.5 sm:p-4 border border-slate-100 shadow-card flex flex-col justify-between transition-all duration-200 hover:shadow-card-hover">
          
