  <!-- MODAL: Custom Syllabus Quote Submission Form -->
  <div id="quoteModal" class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 hidden">
    <div class="bg-white w-full max-w-sm rounded-t-3xl sm:rounded-3xl p-5 space-y-3.5 shadow-2xl">
      <div class="flex items-center justify-between pb-2 border-b border-slate-100">
        <div>
          <h3 class="font-display font-bold text-sm text-[#0d1b2a]">Request Class Assessment</h3>
          <p class="text-[10px] text-slate-500">No obligation • Custom Syllabus Evaluation</p>
        </div>
        <button onclick="closeQuoteModal()" class="w-7 h-7 rounded-full bg-slate-100 text-slate-400 hover:text-slate-600 flex items-center justify-center text-xs">✕</button>
      </div>

      <div class="space-y-2.5 text-xs">
        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-1">Course Name / Code</label>
