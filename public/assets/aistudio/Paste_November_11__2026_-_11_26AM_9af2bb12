              <img src="${card.img}" alt="${card.title}" class="w-full h-full object-cover">
              
              <!-- Floating Icon Pill in top left (matching screenshot) -->
              <div class="absolute top-2.5 left-2.5 w-8 h-8 rounded-lg bg-white/95 backdrop-blur-md shadow-sm flex items-center justify-center border border-white/80">
                ${card.badgeIcon}
              </div>

              <!-- Category Tag -->
              <div class="absolute top-2.5 right-2.5 bg-[#0d1b2a]/80 backdrop-blur-md text-white text-[9px] font-bold px-2 py-0.5 rounded-full">
                ${card.categoryLabel}
              </div>
            </div>

            <!-- Card Content with full, unclipped text matching screenshot -->
            <div class="px-0.5">
              <h3 class="font-display font-extrabold text-[#0d1b2a] text-base sm:text-lg leading-snug">
                ${card.title}
              </h3>
              
              <p class="text-xs sm:text-[13px] text-slate-600 mt-1.5 leading-relaxed">
