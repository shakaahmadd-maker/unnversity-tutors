          <ul id="modalBenefits" class="space-y-1 text-slate-500 text-[11px]">
            <!-- Injected by JS -->
          </ul>
        </div>
      </div>

      <div class="flex gap-2 pt-2">
        <button onclick="requestHelpForCurrentCard()" class="flex-1 py-3 rounded-xl font-display font-bold text-xs bg-amber-500 hover:bg-amber-600 text-slate-950 shadow-md flex items-center justify-center gap-1 tap-bounce">
          <span>Apply to My Course</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
