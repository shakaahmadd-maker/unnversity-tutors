          <button onclick="runAlgorithm('mst')" class="py-2 px-2.5 text-xs font-semibold rounded-lg bg-gray-900 hover:bg-gray-800 text-white transition">
            Prim's MST
          </button>
          <button onclick="runAlgorithm('bfs')" class="py-2 px-2.5 text-xs font-semibold rounded-lg border border-orange-300 bg-orange-50 hover:bg-orange-100 text-orange-700 transition">
            BFS Traversal
          </button>
          <button onclick="runAlgorithm('dfs')" class="py-2 px-2.5 text-xs font-semibold rounded-lg border border-orange-300 bg-orange-50 hover:bg-orange-100 text-orange-700 transition">
            DFS Traversal
          </button>
        </div>

        <button onclick="clearHighlights()" class="w-full py-1.5 text-xs font-medium text-gray-500 hover:text-gray-800 underline mb-3">
          Reset Algorithm Highlights
        </button>

        <!-- Step Output Log -->
        <div id="algoOutput" class="bg-gray-900 text-gray-100 rounded-lg p-3 text-xs mono flex-1 min-h-[120px] overflow-y-auto leading-relaxed">
          <span class="text-orange-400 font-semibold">// Ready</span><br>
