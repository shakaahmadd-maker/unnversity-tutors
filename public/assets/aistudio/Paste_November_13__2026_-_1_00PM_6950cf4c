      <div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-gray-900 text-base">University-Tutors<span class="text-orange-500">.com</span></span>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-orange-50 text-orange-600 border border-orange-200">Graph Theory Studio</span>
        </div>
