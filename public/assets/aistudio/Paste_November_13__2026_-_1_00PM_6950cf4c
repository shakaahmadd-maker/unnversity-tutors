          </button>
          <button id="mode-node" onclick="setMode('node')" class="mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 text-gray-700 hover:bg-gray-200">
            + Add Vertex
          </button>
          <button id="mode-edge" onclick="setMode('edge')" class="mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 text-gray-700 hover:bg-gray-200">
            + Connect Edge
          </button>
          <button id="mode-delete" onclick="setMode('delete')" class="mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 text-red-600 hover:bg-red-50">
            Delete
          </button>
        </div>

        <div class="flex items-center gap-2">
          <!-- 2D / 3D View Switcher -->
          <div class="flex items-center bg-gray-100 p-1 rounded-lg border border-gray-200">
