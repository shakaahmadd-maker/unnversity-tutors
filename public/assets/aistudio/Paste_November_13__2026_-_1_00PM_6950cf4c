          </div>
          <div>
            <label class="block text-[11px] font-semibold text-gray-600 mb-1">Target Node</label>
            <select id="endNodeSelect" class="w-full text-xs border border-gray-300 rounded-lg p-2 bg-white font-semibold"></select>
          </div>
