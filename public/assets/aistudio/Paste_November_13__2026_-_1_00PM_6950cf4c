        </div>
      </div>
    </aside>

    <!-- Center Interactive Canvas -->
    <section class="lg:col-span-6 flex flex-col gap-3">
      <!-- Mode Toolbar -->
      <div class="bg-white rounded-xl border border-gray-200 p-2.5 shadow-sm flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-1.5">
          <button id="mode-select" onclick="setMode('select')" class="mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-orange-500 text-white">
