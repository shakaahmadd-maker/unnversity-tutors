      </button>
    </div>
  </header>

  <!-- Main Workspace -->
  <main class="flex-1 max-w-[1600px] w-full mx-auto p-4 lg:p-6 grid grid-cols-1 lg:grid-cols-12 gap-5">

    <!-- Left Sidebar: Presets & Algorithms -->
    <aside class="lg:col-span-3 flex flex-col gap-4">
      
      <!-- Complex Graph Presets -->
      <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-sm">
        <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-3">1. Complex Graph Presets</h2>
        <div class="grid grid-cols-2 gap-2">
          <button onclick="loadPreset('weighted')" class="text-left p-2.5 rounded-lg border border-orange-200 bg-orange-50/60 hover:bg-orange-100 transition">
            <div class="text-xs font-bold text-gray-900">Weighted Network</div>
            <div class="text-[11px] text-gray-500">Dijkstra / MST ready</div>
          </button>
          <button onclick="loadPreset('petersen')" class="text-left p-2.5 rounded-lg border border-gray-200 hover:border-orange-300 hover:bg-orange-50/40 transition">
            <div class="text-xs font-bold text-gray-900">Petersen Graph</div>
            <div class="text-[11px] text-gray-500">10 vertices, 3-regular</div>
          </button>
          <button onclick="loadPreset('bipartite')" class="text-left p-2.5 rounded-lg border border-gray-200 hover:border-orange-300 hover:bg-orange-50/40 transition">
            <div class="text-xs font-bold text-gray-900">Complete K₃,₃</div>
            <div class="text-[11px] text-gray-500">Non-planar bipartite</div>
          </button>
          <button onclick="loadPreset('dag')" class="text-left p-2.5 rounded-lg border border-gray-200 hover:border-orange-300 hover:bg-orange-50/40 transition">
            <div class="text-xs font-bold text-gray-900">Directed DAG</div>
            <div class="text-[11px] text-gray-500">Topological sort</div>
          </button>
        </div>
      </div>

      <!-- Graph Properties Toggles -->
      <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-sm">
        <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-3">2. Graph Rules & Layout</h2>
        <div class="space-y-2.5 text-sm">
          <label class="flex items-center justify-between cursor-pointer">
            <span class="font-medium text-gray-700">Directed Graph (Digraph)</span>
            <input type="checkbox" id="toggleDirected" onchange="toggleGraphType()" class="w-4 h-4 accent-orange-500 rounded">
          </label>
          <label class="flex items-center justify-between cursor-pointer">
            <span class="font-medium text-gray-700">Weighted Edges</span>
            <input type="checkbox" id="toggleWeighted" checked onchange="draw()" class="w-4 h-4 accent-orange-500 rounded">
