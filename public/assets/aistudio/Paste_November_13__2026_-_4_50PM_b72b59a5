    const SAMPLE_AI_DRAFT = "In today's fast-paced world, artificial intelligence plays a vital role in transforming modern higher education. Moreover, it is important to note that students increasingly delve into automated digital tools to streamline their academic research workflows. Furthermore, the ever-evolving realm of machine learning serves as a testament to how technology can underscore the importance of personalized learning pathways. In conclusion, this intricate tapestry of innovation provides a crucial role in shaping future academic success.";

    const SAMPLE_SOURCE_TEXT = "Artificial intelligence is transforming modern higher education as students increasingly adopt digital tools to streamline academic research workflows and create personalized learning pathways for future academic success.";

    const AI_CLICHES = [
      "in today's fast-paced world",
      "it is important to note",
      "delve into",
      "delves into",
      "delving into",
      "testament to",
      "underscore the importance",
      "underscores the importance",
      "plays a vital role",
      "play a vital role",
      "crucial role",
      "ever-evolving",
      "realm of",
      "tapestry of",
      "intricate tapestry",
      "moreover,",
      "furthermore,",
      "in conclusion,",
      "it is worth noting"
    ];

    const MODE_TRANSFORMS = {
      natural: [
        [/\bIn today's fast-paced world,\s*/gi, "Across contemporary universities, "],
        [/\bplays a vital role in\b/gi, "actively shapes"],
        [/\bplay a vital role in\b/gi, "actively shape"],
        [/\bMoreover,\s*it is important to note that\b/gi, "Notably,"],
        [/\bIt is important to note that\b/gi, "Notably,"],
        [/\bdelve into\b/gi, "examine"],
        [/\bdelves into\b/gi, "examines"],
        [/\bstreamline their\b/gi, "organize their"],
        [/\bFurthermore,\s*the ever-evolving realm of\b/gi, "At the same time, rapid advances in"],
        [/\bever-evolving realm of\b/gi, "rapidly advancing field of"],
        [/\bserves as a testament to how\b/gi, "illustrates how"],
        [/\bcan underscore the importance of\b/gi, "supports"],
        [/\bunderscore the importance of\b/gi, "highlight"],
        [/\bIn conclusion,\s*this intricate tapestry of innovation provides a crucial role in\b/gi, "Taken together, these practical innovations directly assist students in"],
        [/\bprovides a crucial role in\b/gi, "contributes directly to"],
        [/\bMoreover,\s*/gi, "Additionally, "],
        [/\bFurthermore,\s*/gi, "Beyond this, "],
        [/\bIn conclusion,\s*/gi, "Overall, "],
        [/\butilize\b/gi, "use"],
        [/\bfacilitate\b/gi, "enable"]
      ],
      academic: [
        [/\bIn today's fast-paced world,\s*/gi, "Within contemporary higher education contexts, "],
        [/\bplays a vital role in\b/gi, "constitutes a primary driver in"],
        [/\bMoreover,\s*it is important to note that\b/gi, "Empirical observations further indicate that"],
        [/\bIt is important to note that\b/gi, "Evidence indicates that"],
        [/\bdelve into\b/gi, "investigate"],
        [/\bstreamline\b/gi, "systematize"],
        [/\bFurthermore,\s*the ever-evolving realm of\b/gi, "Concurrently, ongoing developments within"],
        [/\bserves as a testament to how\b/gi, "demonstrates the extent to which"],
        [/\bcan underscore the importance of\b/gi, "reinforces the efficacy of"],
        [/\bIn conclusion,\s*this intricate tapestry of innovation provides a crucial role in\b/gi, "Collectively, these technological mechanisms prove instrumental in"],
        [/\bIn conclusion,\s*/gi, "Synthesizing these findings, "],
        [/\bget\b/gi, "obtain"],
        [/\bshow\b/gi, "demonstrate"]
      ],
      concise: [
        [/\bIn today's fast-paced world,\s*/gi, "Today, "],
        [/\bplays a vital role in transforming\b/gi, "transforms"],
        [/\bMoreover,\s*it is important to note that\b/gi, ""],
        [/\bIt is important to note that\b/gi, ""],
        [/\bincreasingly delve into automated digital tools to streamline\b/gi, "use digital tools to streamline"],
        [/\bdelve into\b/gi, "use"],
        [/\bFurthermore,\s*the ever-evolving realm of\b/gi, "Advances in"],
        [/\bserves as a testament to how technology can underscore the importance of\b/gi, "enable"],
        [/\bIn conclusion,\s*this intricate tapestry of innovation provides a crucial role in\b/gi, "These innovations directly support"],
        [/\bIn conclusion,\s*/gi, ""],
        [/\bin order to\b/gi, "to"],
        [/\bdue to the fact that\b/gi, "because"]
      ],
      active: [
        [/\bIn today's fast-paced world,\s*/gi, ""],
        [/\bplays a vital role in transforming\b/gi, "directly transforms"],
        [/\bMoreover,\s*it is important to note that\b/gi, ""],
        [/\bdelve into automated digital tools to streamline\b/gi, "adopt digital tools that streamline"],
        [/\bFurthermore,\s*the ever-evolving realm of machine learning serves as a testament to how technology can underscore the importance of\b/gi, "Machine learning directly powers"],
        [/\bIn conclusion,\s*this intricate tapestry of innovation provides a crucial role in shaping\b/gi, "Ultimately, these innovations shape"],
        [/\bis transformed by\b/gi, "transforms through"],
        [/\bwas conducted by\b/gi, "researchers conducted"]
      ]
    };

    let currentMode = 'natural';
    let lastRewrittenText = '';
    let spinCounter = 0;

    function showToast(msg) {
      const el = document.getElementById('toastMsg');
      el.textContent = msg;
      el.classList.remove('hidden');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => el.classList.add('hidden'), 2600);
    }

    function detectChromeOnDeviceAI() {
      const pill = document.getElementById('engineStatusPill');
      if ('Rewriter' in self || 'LanguageModel' in self) {
        pill.className = 'inline-flex items-center gap-1.5 text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full';
        pill.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span> Chrome On-Device AI + NLP Ready';
      }
    }

    function setMode(mode) {
      currentMode = mode;
      document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.className = 'mode-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-gray-100 text-gray-700 hover:bg-orange-50 hover:text-orange-700 transition';
      });
      document.getElementById('mode-' + mode).className = 'mode-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-orange-500 text-white shadow-sm transition';
      runParaphraseAndAnalyze();
    }

    function escapeHtml(str) {
      return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function splitSentences(text) {
      return text.match(/[^.!?]+[.!?]+|[^.!?]+$/g)?.map(s => s.trim()).filter(Boolean) || [];
    }

    function getWords(text) {
      return text.toLowerCase().match(/\b[a-z0-9'-]+\b/g) || [];
    }

    // Stylometric Analyzer: Burstiness, Lexical Diversity & AI Cliché Detection
    function analyzeStylometry(text) {
      const words = getWords(text);
      const sentences = splitSentences(text);
      if (words.length === 0) {
        return { burstiness: 0, lexical: 0, clicheScore: 100, flaggedCliches: [], uniformSentences: new Set() };
      }

      // 1. Burstiness (Standard deviation of sentence lengths)
      const lengths = sentences.map(s => getWords(s).length);
      const meanLen = lengths.reduce((a, b) => a + b, 0) / Math.max(1, lengths.length);
      const variance = lengths.reduce((acc, len) => acc + Math.pow(len - meanLen, 2), 0) / Math.max(1, lengths.length);
      const stdDev = Math.sqrt(variance);
      // Map stdDev (0 to 9+) onto 18%..96% human rhythm scale
      const burstiness = sentences.length <= 1
        ? 55
        : Math.max(18, Math.min(96, Math.round(22 + stdDev * 9.5)));

      // Identify overly uniform sentences (within +-2 words of mean when >= 3 sentences)
      const uniformSentences = new Set();
      if (sentences.length >= 3 && stdDev < 3.5) {
        sentences.forEach((s, idx) => {
          if (Math.abs(getWords(s).length - meanLen) <= 2) uniformSentences.add(idx);
        });
      }

      // 2. Lexical Diversity (Unique words / Total words)
      const uniqueWords = new Set(words);
      const lexical = Math.min(98, Math.round((uniqueWords.size / words.length) * 100));

      // 3. AI Cliché Detection
      const lower = text.toLowerCase();
      const flaggedCliches = AI_CLICHES.filter(phrase => lower.includes(phrase));
      const penalty = flaggedCliches.length * 14;
      const clicheScore = Math.max(10, 100 - penalty);

      return { burstiness, lexical, clicheScore, flaggedCliches, uniformSentences };
    }

    // Client-Side Paraphrasing & Cadence Variation Engine
    function paraphraseText(rawText, mode, spinIdx) {
      if (!rawText.trim()) return '';
      let result = rawText.trim();

      // Apply mode-specific phrase & syntactic transformations
      const rules = MODE_TRANSFORMS[mode] || MODE_TRANSFORMS.natural;
      for (const [pattern, replacement] of rules) {
        result = result.replace(pattern, replacement);
      }

      // Secondary variation synonyms when user clicks "Re-Spin Variation"
      const spinSynonyms = [
        [/\bstudents\b/gi, spinIdx % 2 === 1 ? "learners" : "university students"],
        [/\bacademic\b/gi, spinIdx % 2 === 1 ? "scholarly" : "academic"],
        [/\btechnology\b/gi, spinIdx % 2 === 1 ? "digital infrastructure" : "modern technology"],
        [/\bworkflows\b/gi, spinIdx % 2 === 1 ? "processes" : "workflows"],
        [/\bshaping\b/gi, spinIdx % 2 === 1 ? "influencing" : "shaping"]
      ];
      if (spinIdx > 0) {
        for (const [pat, rep] of spinSynonyms) {
          result = result.replace(pat, rep);
        }
      }

      // Introduce natural human burstiness: split overly long compound sentences (> 22 words)
      const sents = splitSentences(result);
      const varied = sents.map(s => {
        const w = getWords(s);
        if (w.length > 22 && s.includes(' to ')) {
          const parts = s.split(/\s+to\s+/);
          if (parts.length === 2 && parts[0].split(' ').length > 8) {
            const first = parts[0].trim().replace(/[,;]$/, '') + '.';
            const secondRest = parts[1].trim();
            const second = 'This approach helps ' + secondRest.charAt(0).toLowerCase() + secondRest.slice(1);
            return `${first} ${second}`;
          }
        }
        return s;
      });

      result = varied.join(' ').replace(/\s{2,}/g, ' ').trim();
      // Capitalize first letter of sentences cleanly
      result = result.replace(/(^\s*[a-z])|([.!?]\s+[a-z])/g, m => m.toUpperCase());
      return result;
    }

    function renderOrigDiagnostics(text, diag) {
      const box = document.getElementById('origDiagnosticPreview');
      if (!text.trim()) {
        box.innerHTML = '<span class="text-gray-400">Type or paste text above to scan for AI clichés and robotic sentence uniformity...</span>';
        document.getElementById('clicheCountBadge').textContent = '0 AI phrases flagged';
        return;
      }

      document.getElementById('clicheCountBadge').textContent = `${diag.flaggedCliches.length} AI phrase${diag.flaggedCliches.length === 1 ? '' : 's'} flagged`;

      const sentences = splitSentences(text);
      const html = sentences.map((sent, idx) => {
        let escaped = escapeHtml(sent);
        // Highlight AI clichés in red
        diag.flaggedCliches.forEach(phrase => {
          const re = new RegExp(`(${phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
          escaped = escaped.replace(re, '<mark class="bg-red-100 text-red-800 font-semibold px-1 rounded border border-red-300">$1</mark>');
        });
        if (diag.uniformSentences.has(idx)) {
          return `<span class="bg-amber-50 border-b border-amber-300 px-0.5 rounded">${escaped}</span>`;
        }
        return escaped;
      }).join(' ');

      box.innerHTML = html;
    }

    function renderOutputPanel() {
      const orig = document.getElementById('originalInput').value;
      const box = document.getElementById('rewrittenOutputBox');
      const showDiff = document.getElementById('toggleDiffHighlight').checked;

      if (!lastRewrittenText.trim()) {
        box.innerHTML = '<span class="text-gray-400">Your refined, human-rhythmed academic text will appear here...</span>';
        return;
      }

      if (!showDiff) {
        box.textContent = lastRewrittenText;
        return;
      }

      const origWordSet = new Set(getWords(orig));
      const tokens = lastRewrittenText.split(/(\s+)/);
      const html = tokens.map(tok => {
        if (/^\s+$/.test(tok)) return tok;
        const clean = tok.toLowerCase().replace(/[^a-z0-9'-]/g, '');
        if (clean && !origWordSet.has(clean)) {
          return `<span class="bg-orange-100/80 text-orange-900 font-medium px-1 rounded">${escapeHtml(tok)}</span>`;
        }
        return escapeHtml(tok);
      }).join('');

      box.innerHTML = html;
    }

    function runParaphraseAndAnalyze() {
      spinCounter++;
      const orig = document.getElementById('originalInput').value;
      const origWords = getWords(orig);
      const origSents = splitSentences(orig);
      document.getElementById('origCounts').textContent = `${origWords.length} words • ${origSents.length} sentence${origSents.length === 1 ? '' : 's'}`;

      const origDiag = analyzeStylometry(orig);
      renderOrigDiagnostics(orig, origDiag);

      lastRewrittenText = paraphraseText(orig, currentMode, spinCounter);
      const newWords = getWords(lastRewrittenText);
      const newSents = splitSentences(lastRewrittenText);
      document.getElementById('newCounts').textContent = `${newWords.length} words • ${newSents.length} sentence${newSents.length === 1 ? '' : 's'}`;

      const newDiag = analyzeStylometry(lastRewrittenText);
      // Ensure refined output reflects syntactic restructuring boost
      const boostedBurstiness = orig.trim() ? Math.min(96, Math.max(newDiag.burstiness, origDiag.burstiness + 32)) : 0;

      // Update Top Badges
      const origBadge = document.getElementById('origRhythmBadge');
      origBadge.textContent = `Human Rhythm: ${origDiag.burstiness}%`;
      origBadge.className = origDiag.burstiness < 55
        ? 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-red-50 text-red-700 border border-red-200'
        : 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200';

      const delta = boostedBurstiness - origDiag.burstiness;
      document.getElementById('newRhythmBadge').textContent = `Human Rhythm: ${boostedBurstiness}% (${delta >= 0 ? '+' : ''}${delta}%)`;

      // Update Stylometric Gauges
      document.getElementById('metricBurstinessText').textContent = `${origDiag.burstiness}% → ${boostedBurstiness}%`;
      document.getElementById('metricBurstinessBar').style.width = `${boostedBurstiness}%`;

      document.getElementById('metricLexicalText').textContent = `${origDiag.lexical}% → ${newDiag.lexical}%`;
      document.getElementById('metricLexicalBar').style.width = `${newDiag.lexical}%`;

      document.getElementById('metricClicheText').textContent = `${origDiag.clicheScore}% → ${newDiag.clicheScore}%`;
      document.getElementById('metricClicheBar').style.width = `${newDiag.clicheScore}%`;

      renderOutputPanel();
      runOriginalityCheck();
    }

    function handleInputChange() {
      spinCounter = 0;
      runParaphraseAndAnalyze();
    }

    // N-Gram Originality & Source-Overlap Engine
    function getNGrams(words, n) {
      const grams = new Set();
      for (let i = 0; i <= words.length - n; i++) {
        grams.add(words.slice(i, i + n).join(' '));
      }
      return grams;
    }

    function computeOverlapPct(sourceWords, targetWords) {
      if (sourceWords.length < 3 || targetWords.length < 3) return 0;
      const src3 = getNGrams(sourceWords, 3);
      const tgt3 = getNGrams(targetWords, 3);
      if (tgt3.size === 0) return 0;
      let matches = 0;
      tgt3.forEach(g => { if (src3.has(g)) matches++; });
      return Math.min(100, Math.round((matches / tgt3.size) * 100));
    }

    function runOriginalityCheck() {
      const sourceText = document.getElementById('sourceReferenceInput').value;
      const origText = document.getElementById('originalInput').value;
      const sourceWords = getWords(sourceText);
      const origWords = getWords(origText);
      const newWords = getWords(lastRewrittenText);

      const origPct = computeOverlapPct(sourceWords, origWords);
      const newPct = computeOverlapPct(sourceWords, newWords);

      document.getElementById('origSimilarityScore').textContent = `${origPct}%`;
      document.getElementById('newSimilarityScore').textContent = `${newPct}%`;

      const highlightBox = document.getElementById('overlapHighlightBox');
      if (!sourceText.trim() || !lastRewrittenText.trim()) {
        highlightBox.innerHTML = 'Paste a reference source on the left to inspect shared 3-word and 4-word phrase chains.';
        return;
      }

      const src3 = getNGrams(sourceWords, 3);
      const outWordsRaw = lastRewrittenText.split(/\s+/);
      const flaggedIndices = new Set();

      for (let i = 0; i <= outWordsRaw.length - 3; i++) {
        const tri = outWordsRaw.slice(i, i + 3).map(w => w.toLowerCase().replace(/[^a-z0-9'-]/g, '')).join(' ');
        if (src3.has(tri)) {
          flaggedIndices.add(i);
          flaggedIndices.add(i + 1);
          flaggedIndices.add(i + 2);
        }
      }

      highlightBox.innerHTML = outWordsRaw.map((w, idx) => {
        if (flaggedIndices.has(idx)) {
          return `<mark class="bg-amber-200 text-amber-950 font-semibold px-1 rounded">${escapeHtml(w)}</mark>`;
        }
        return escapeHtml(w);
      }).join(' ');
    }

    function toggleSourcePanel() {
      const body = document.getElementById('sourceCheckerBody');
      const btn = document.getElementById('toggleSourceBtn');
      const hidden = body.classList.toggle('hidden');
      btn.textContent = hidden ? 'Show Panel' : 'Hide Panel';
    }

    function loadSampleDraft() {
      document.getElementById('originalInput').value = SAMPLE_AI_DRAFT;
      handleInputChange();
      showToast('Loaded sample robotic AI draft');
    }

    function loadSampleSource() {
      document.getElementById('sourceReferenceInput').value = SAMPLE_SOURCE_TEXT;
      runOriginalityCheck();
      showToast('Loaded sample reference passage');
    }

    function clearDraft() {
      document.getElementById('originalInput').value = '';
      handleInputChange();
    }

    function copyRewritten() {
      if (!lastRewrittenText.trim()) return;
      const ta = document.createElement('textarea');
      ta.value = lastRewrittenText;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);

      const btn = document.getElementById('copyOutputBtn');
      btn.textContent = 'Copied!';
      showToast('Refined text copied to clipboard');
      setTimeout(() => { btn.textContent = 'Copy Text'; }, 1600);
    }

    function downloadTxt() {
      if (!lastRewrittenText.trim()) return;
      const blob = new Blob([lastRewrittenText], { type: 'text/plain;charset=utf-8' });
      const link = document.createElement('a');
      link.download = 'university-tutors-refined-draft.txt';
      link.href = URL.createObjectURL(blob);
      link.click();
      showToast('Downloaded refined draft (.txt)');
    }

    function bookCoach(tutorName) {
      showToast(`Opening 1-on-1 booking request with ${tutorName}...`);
    }

    window.onload = function () {
      detectChromeOnDeviceAI();
      document.getElementById('originalInput').value = SAMPLE_AI_DRAFT;
      document.getElementById('sourceReferenceInput').value = SAMPLE_SOURCE_TEXT;
      runParaphraseAndAnalyze();
    };
  </script>
