    <script>
        // Modal management
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
            document.body.style.overflow = '';
        }

        // Select specific support package
        function selectPackage(packageName) {
            document.getElementById('modalPackage').value = packageName;
            openModal('bookingModal');
        }

        // Pre-select discipline when clicking a tutor card
        function bookWithTutor(disciplineName) {
            const disciplineSelect = document.getElementById('modalDiscipline');
            if (disciplineSelect) {
                disciplineSelect.value = disciplineName;
            }
            openModal('bookingModal');
        }

        // Handle booking submission state
        function submitBooking(event) {
            event.preventDefault();
            document.getElementById('bookingForm').classList.add('hidden');
            document.getElementById('bookingSuccess').classList.remove('hidden');
        }

        // Handle inline quick enquiry submission
        function submitQuickEnquiry(event) {
            event.preventDefault();
            document.getElementById('quickEnquiryForm').classList.add('hidden');
            document.getElementById('quickEnquirySuccess').classList.remove('hidden');
        }

        function resetQuickEnquiry() {
            document.getElementById('quickEnquiryForm').reset();
            document.getElementById('quickEnquirySuccess').classList.add('hidden');
            document.getElementById('quickEnquiryForm').classList.remove('hidden');
        }

        // FAQ Accordion Toggle
        function toggleFaq(button) {
            const content = button.nextElementSibling;
            const icon = button.querySelector('svg');
            content.classList.toggle('hidden');
            icon.classList.toggle('rotate-180');
        }

        // Mentor Subject Filter
        function filterMentors(category, btnElement) {
            document.querySelectorAll('.mentor-filter-btn').forEach(btn => {
                btn.classList.remove('bg-orange-600', 'text-white');
                btn.classList.add('bg-orange-50', 'text-slate-700');
            });
            btnElement.classList.remove('bg-orange-50', 'text-slate-700');
            btnElement.classList.add('bg-orange-600', 'text-white');

            document.querySelectorAll('.mentor-card').forEach(card => {
                if (category === 'all' || card.dataset.cat === category) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }
    </script>
</body>
</html>