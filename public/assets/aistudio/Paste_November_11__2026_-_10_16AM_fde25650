  <style>
    /* Smooth CSS height transitions for accordion behavior */
    .collapsible-container {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
    }
    .collapsible-container.is-expanded {
      max-height: 1200px;
      opacity: 1;
    }
    .rotate-chevron {
      transition: transform 0.3s ease;
    }
    .is-expanded .rotate-chevron {
      transform: rotate(180deg);
    }

    /* 3D Isometric Educational Letter Styling & Floating Animation */
    .edu-3d-scene {
      perspective: 700px;
    }
    .edu-3d-wrapper {
      transform-style: preserve-3d;
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      animation: gentle-float 4s ease-in-out infinite alternate;
    }
    .group:hover .edu-3d-wrapper {
      transform: translateY(-8px) scale(1.08);
      animation-play-state: paused;
    }
    @keyframes gentle-float {
      0% {
        transform: translateY(0px);
      }
      100% {
        transform: translateY(-6px);
      }
    }
  </style>
